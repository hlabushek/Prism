# ==============================================================================
# RouterAI API Gateway Configuration (https://routerai.ru/api/v1)
# ==============================================================================
ROUTERAI_API_KEY=your_routerai_api_key_here
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Models defined strictly via environment variables
EMBEDDING_MODEL=openai/text-embedding-3-small
CHEAP_LLM_MODEL=openai/gpt-4o-mini
LLM_MODEL=openai/gpt-5.6-luna

# ==============================================================================
# Network & Proxy (SOCKS5 for blocked media and feeds)
# ==============================================================================
PROXY_URL=socks5://nnpA9B:8VTTJM@85.195.81.147:10108

# ==============================================================================
# APScheduler Task Intervals (in minutes)
# ==============================================================================
PARSE_INTERVAL_MINUTES=30
LLM_ANALYSIS_INTERVAL_MINUTES=60

# ==============================================================================
# Database Configuration (pgvector PostgreSQL)
# ==============================================================================
POSTGRES_DB=prism_news
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prism_news

# ==============================================================================
# Telegram Mini App Configuration
