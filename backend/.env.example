# ==============================================================================
# 💎 PRISM NEWS AI — ПРИМЕР ШАБЛОНА КОНФИГУРАЦИИ (.env.example)
# ==============================================================================
# Скопируйте этот файл в .env и заполните своими реальными ключами:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. ОСНОВНЫЕ НАСТРОЙКИ СЕРВЕРА И АДМИНИСТРАТОРА
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="Prism News AI"
VERSION=1.0.0
API_V1_STR=/api/v1

# Telegram Username администратора (без @), которому разрешен вход в админку
ADMIN_TELEGRAM_USERNAME=Not_Hleb
ADMIN_TELEGRAM_ID=6541226081

# Секретный ключ JWT для шифрования пользовательских сессий
SECRET_KEY=change_this_to_a_random_super_secret_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ------------------------------------------------------------------------------
# 2. TELEGRAM БОТ, КАНАЛ И ОБСУЖДЕНИЯ
# ------------------------------------------------------------------------------
# Токен бота, полученный от @BotFather (например, 123456789:ABCdef...)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Юзернейм вашего бота (без @)
TELEGRAM_BOT_USERNAME=YourPrismBot

# ID или тег Telegram-канала (например, @your_channel_name или -100123456789)
TELEGRAM_CHANNEL_ID=@your_channel_name

# ID группы обсуждения, привязанной к каналу (для комментариев)
TELEGRAM_DISCUSSION_GROUP_ID=-1001234567890

# ID кастомного эмодзи для брендирования постов (получить через @ShowJsonBot)
TELEGRAM_CUSTOM_EMOJI_ID=5222200612938099305

# Автопостинг в канал (true / false)
AUTO_POST_TO_CHANNEL=true

# Двусторонняя синхронизация комментариев Сайт ⇄ Telegram (true / false)
SYNC_TELEGRAM_COMMENTS=true

# ------------------------------------------------------------------------------
# 3. ИИ-ШЛЮЗ И МОДЕЛИ
# ------------------------------------------------------------------------------
# API-ключ к RouterAI / OpenRouter / OpenAI
ROUTERAI_API_KEY=your_ai_api_key_here

# Базовый URL API эндпоинта
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Модель эмбеддингов
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Быстрая LLM для фильтрации шума
CHEAP_LLM_MODEL=openai/gpt-4o-mini

# Основная LLM для спектрального анализа
LLM_MODEL=openai/gpt-5.6-luna

# Порог важности новости (1-10)
IMPORTANCE_THRESHOLD=6

# ------------------------------------------------------------------------------
# 4. ПРОКСИ ДЛЯ ПАРСИНГА (SOCKS5 / HTTP)
# ------------------------------------------------------------------------------
# Формат: socks5://user:password@ip:port или оставить пустым, если прокси не нужен
PROXY_URL=socks5://user:pass@host:port

# ------------------------------------------------------------------------------
# 5. БАЗА ДАННЫХ
# ------------------------------------------------------------------------------
# SQLite (по умолчанию для локального запуска)
DATABASE_URL=sqlite+aiosqlite:///./prism_news.db

# PostgreSQL (для продакшена):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/prism_news

# ------------------------------------------------------------------------------
# 6. РАСПИСАНИЕ ФОНОВЫХ ЗАДАЧ
# ------------------------------------------------------------------------------
PARSE_INTERVAL_MINUTES=10
LLM_ANALYSIS_INTERVAL_MINUTES=25
RECALCULATE_TRUST_INTERVAL_HOURS=24
LOOKBACK_HOURS=24
SIMILARITY_THRESHOLD=0.80
